{
  "info": {
    "name": "LendEase API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "LendEase backend (/v1). Development: SMS_PROVIDER=console and EMAIL_PROVIDER=console return `dev_otp` in the response. Swagger UI: {{base_url}}/doc/"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5050/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "mobile",
      "value": "9876543210"
    },
    {
      "key": "attempt_id",
      "value": ""
    },
    {
      "key": "loan_id",
      "value": ""
    },
    {
      "key": "card_attempt_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "otp",
                "send"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"{{mobile}}\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP (register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Replace otp_code with dev_otp from Send OTP. A returning user with an MPIN gets requires_unlock=true.",
            "url": {
              "raw": "{{base_url}}/authentication/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "otp",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"{{mobile}}\",\n  \"otp_code\": \"000000\",\n  \"full_name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || {};",
                  "if (r.access_token) pm.collectionVariables.set('access_token', r.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Session on this device",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Requested-With",
                "value": "lendease"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "session"
              ]
            }
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Requested-With",
                "value": "lendease"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || {};",
                  "if (r.access_token) pm.collectionVariables.set('access_token', r.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unlock with MPIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Requested-With",
                "value": "lendease"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/unlock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "unlock"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mpin\": \"4826\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || {};",
                  "if (r.access_token) pm.collectionVariables.set('access_token', r.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "me"
              ]
            }
          }
        },
        {
          "name": "Send email code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/email/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "email",
                "send"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Verify email code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "Replace with dev_otp from Send email code.",
            "url": {
              "raw": "{{base_url}}/authentication/email/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "email",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"000000\"\n}"
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Requested-With",
                "value": "lendease"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/authentication/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authentication",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Onboarding",
      "item": [
