              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/onboarding/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "onboarding",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Loans",
      "item": [
        {
          "name": "Providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/loans/providers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "providers"
              ]
            }
          }
        },
        {
          "name": "Start Bajaj loan verification (sends OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "OTP goes to the verified mobile; dev_otp is returned in development.",
            "url": {
              "raw": "{{base_url}}/loans/link/start",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "link",
                "start"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_code\": \"BAJAJ_FINANCE\",\n  \"identifiers\": {\n    \"loan_account_number\": \"BFL4482019\",\n    \"customer_id\": \"CUST55120\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || {};",
                  "if (r.attempt_id) pm.collectionVariables.set('attempt_id', r.attempt_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Bajaj loan OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "Replace code with dev_otp from the start response.",
            "url": {
              "raw": "{{base_url}}/loans/link/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "link",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attempt_id\": \"{{attempt_id}}\",\n  \"code\": \"000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().response || {};",
                  "if (r.loan) pm.collectionVariables.set('loan_id', r.loan.loan_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Linked loans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/loans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans"
              ]
            }
          }
        },
        {
          "name": "Refresh from lender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
