# ─────────────────────────────────────────────────────────────────────────────
# LendEase backend configuration. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=DEV                      # DEV | PROD   (TEST is used by pytest)
APP_NAME=LendEase
APP_SECRET_KEY=change-me         # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15

# Field encryption (loan numbers, provider tokens):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Server-side pepper for MPIN hashes (min 32 chars). Changing it invalidates every MPIN.
MPIN_PEPPER=

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/Fintech
AUTO_CREATE_TABLES=false         # keep false; use "flask db upgrade"

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Sessions / app lock
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_LOCK_MINUTES=15
MPIN_MAX_ATTEMPTS=5
REFRESH_COOKIE_SECURE=false      # true in production (HTTPS)

# Biometric unlock (WebAuthn). RP ID = your domain without scheme/port.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LendEase
WEBAUTHN_ORIGIN=http://localhost:3000

# OTP SMS: msg91 | fast2sms | console (console = DEV only; prints OTP to backend log)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Rate limiting store (use redis://host:6379 in production)
RATELIMIT_STORAGE_URI=memory://

# Email verification: smtp | console (console = DEV only; prints the code to the backend log)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                   # e.g. a Gmail app password
SMTP_USE_TLS=true
MAIL_FROM=

# Card linking: OTP to the user's verified mobile for the chosen bank (uses SMS_PROVIDER)
CARD_LINK_OTP_TTL_SECONDS=300
CARD_LINK_MAX_STARTS_PER_HOUR=10

# Lender integration (no lender integrated yet; empty = not configured)
LOAN_DATA_PROVIDER=
LOAN_LINK_TTL_MINUTES=10

# Razorpay — key id/secret from Dashboard → Settings → API Keys (test keys start rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # Dashboard → Webhooks → secret you choose
# Partner that credits collected EMIs to the lender. Empty = lender NOT credited; live payments refused.
LOAN_SETTLEMENT_PROVIDER=
PAYMENT_CONVENIENCE_FEE_INR=0.00
MIN_EMI_PAYMENT_INR=1.00
MAX_EMI_PAYMENT_INR=500000
